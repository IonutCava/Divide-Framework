#ifndef _WATER_DATA_CMN_
#define _WATER_DATA_CMN_

// Keep in sync with WaterTests.cpp GetWaterDetailsCPU.
#define UNDERWATER_SHORELINE_HALF_WIDTH 0.75f
#define UNDERWATER_SHALLOW_FADE         20.0f

bool IsWithinWaterFootprint(in WaterBodyData data, in vec3 vertexW)
{
    return all(greaterThan(data.extents.xyz, vec3(0.f))) &&
           all(lessThanEqual(abs(vertexW.xz - data.positionW.xz), data.extents.xz * 0.5f));
}

bool IsUnderWater(in vec3 vertexW)
{
    for (int i = 0; i < GLOBAL_WATER_BODIES_COUNT; ++i)
    {
        const WaterBodyData data = dvd_waterEntities[i];
        const vec3 extents = data.extents.xyz;
        const vec3 position = data.positionW.xyz;

        if (IsWithinWaterFootprint(data, vertexW))
        {
            const float depth = position.y - extents.y;
            if (vertexW.y < position.y && vertexW.y > depth)
            {
                return true;
            }
        }
    }

    return false;
}

// x = blend toward underwater look (0 dry .. 1 submerged)
// y = shallow factor (1 near surface sand .. 0 deeper caustics)
vec2 GetWaterDetails(in vec3 vertexW)
{
    float blendWeight = 0.0f;
    float shallowFactor = 1.0f;

    for (int i = 0; i < GLOBAL_WATER_BODIES_COUNT; ++i)
    {
        const WaterBodyData data = dvd_waterEntities[i];
        const vec3 position = data.positionW.xyz;
        const vec3 extents = data.extents.xyz;

        if (!IsWithinWaterFootprint(data, vertexW))
        {
            continue;
        }

        const float waterBottom = position.y - extents.y;
        const float surfaceY = position.y;

        // Match PointInsideWater / IsUnderWater volume: no blend below the water bottom.
        float bodyBlend = 0.0f;
        if (vertexW.y > waterBottom)
        {
            bodyBlend = 1.0f - smoothstep(surfaceY - UNDERWATER_SHORELINE_HALF_WIDTH,
                                          surfaceY + UNDERWATER_SHORELINE_HALF_WIDTH,
                                          vertexW.y);
        }

        blendWeight = max(blendWeight, bodyBlend);

        if (bodyBlend > 0.0f && vertexW.y < surfaceY)
        {
            const float fadeRange = max(min(extents.y, UNDERWATER_SHALLOW_FADE), M_EPSILON);
            const float depthBelowSurface = surfaceY - vertexW.y;
            shallowFactor = min(shallowFactor, Saturate(1.0f - depthBelowSurface / fadeRange));
        }
    }

    return Saturate(vec2(blendWeight, shallowFactor));
}
#endif //_WATER_DATA_CMN_
