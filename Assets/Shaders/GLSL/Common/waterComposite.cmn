#ifndef _WATER_COMPOSITE_CMN_
#define _WATER_COMPOSITE_CMN_

#define WATER_FRESNEL_F0 0.020373188f
#define WATER_POWER5(X) ((X) * (X) * (X) * (X) * (X))
#define WATER_FRESNEL(COS_THETA) (WATER_FRESNEL_F0 + (1.f - WATER_FRESNEL_F0) * WATER_POWER5(1.f - (COS_THETA)))
#define WATER_WAVE_OFFSET(WAVE_NORMAL, SURFACE_NORMAL, NOISE_FACTOR) \
    (((WAVE_NORMAL) - (SURFACE_NORMAL)) * (NOISE_FACTOR))
#define WATER_COMPOSITE(REFRACTION, REFLECTION, FRESNEL) \
    ((REFRACTION) * (1.f - (FRESNEL)) + (REFLECTION) * (FRESNEL))

#endif //_WATER_COMPOSITE_CMN_
