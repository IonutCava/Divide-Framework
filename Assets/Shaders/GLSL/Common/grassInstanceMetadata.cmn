#ifndef DVD_GRASS_INSTANCE_METADATA_CMN_
#define DVD_GRASS_INSTANCE_METADATA_CMN_

#define GRASS_PACK_METADATA(LOD, INDEX) ((LOD) + 4u * ((INDEX) % 12u))
#define GRASS_METADATA_LOD(METADATA) ((METADATA) % 4u)
#define GRASS_METADATA_TINT(METADATA) ((METADATA) / 4u)

#endif
