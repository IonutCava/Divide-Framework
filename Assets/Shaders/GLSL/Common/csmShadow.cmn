#ifndef _CSM_SHADOW_CMN_
#define _CSM_SHADOW_CMN_

#define CSM_BLEND_FRACTION 0.1f
#define CSM_BLEND_START(NEAR, FAR) ((FAR) - ((FAR) - (NEAR)) * CSM_BLEND_FRACTION)
#define CSM_BLEND_LINEAR_WEIGHT(DEPTH, START, FAR) \
    ((FAR) > (START) ? clamp(((DEPTH) - (START)) / ((FAR) - (START)), 0.f, 1.f) : 0.f)
#define CSM_BLEND_SMOOTH_WEIGHT(T) ((T) * (T) * (3.f - 2.f * (T)))
#define CSM_DEPTH_SCALE_SQUARED(GRADIENT_SQ, REFERENCE_SQ) ((GRADIENT_SQ) / (REFERENCE_SQ))
#define CSM_MIN_VARIANCE_FOR_SCALE(MIN_VARIANCE, SCALE_SQ) ((MIN_VARIANCE) * (SCALE_SQ))
#define CSM_DEPTH_BIAS_FOR_SCALE(BIAS, SCALE) ((BIAS) * (SCALE))

#endif //_CSM_SHADOW_CMN_
