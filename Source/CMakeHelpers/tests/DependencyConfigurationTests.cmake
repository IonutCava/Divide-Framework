cmake_minimum_required(VERSION 3.29.2)
set(DIVIDE_VECTOR_EXTENSION_SET SSE42)
set(VCPKG_MANIFEST_FEATURES custom tests)
set(BUILD_TESTING_INTERNAL OFF)
include("${CMAKE_CURRENT_LIST_DIR}/../ConfigureDependencies.cmake")
if(NOT VCPKG_MANIFEST_FEATURES STREQUAL "custom")
    message(FATAL_ERROR "Tests-off must remove tests without removing user features")
endif()

set(BUILD_TESTING_INTERNAL ON)
include("${CMAKE_CURRENT_LIST_DIR}/../ConfigureDependencies.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/../ConfigureDependencies.cmake")
if(NOT VCPKG_MANIFEST_FEATURES STREQUAL "custom;tests")
    message(FATAL_ERROR "Tests-on must select the tests feature exactly once")
endif()

set(BUILD_TESTING_INTERNAL OFF)
include("${CMAKE_CURRENT_LIST_DIR}/../ConfigureDependencies.cmake")
if(NOT VCPKG_MANIFEST_FEATURES STREQUAL "custom")
    message(FATAL_ERROR "Switching tests off must remove a stale tests selection")
endif()

message(STATUS "Dependency feature configuration tests passed")

include("${CMAKE_CURRENT_LIST_DIR}/../OverlayPorts/joltphysics/simd-options.cmake")
foreach(level IN ITEMS SSE42 AVX AVX2 AVX512 AUTO NEON)
    set(DIVIDE_VECTOR_EXTENSION_SET "${level}")
    include("${CMAKE_CURRENT_LIST_DIR}/../ConfigureDependencies.cmake")
    set(features "")
    if(level MATCHES "^AVX")
        string(TOLOWER "${level}" feature)
        if(NOT "jolt-${feature}" IN_LIST VCPKG_MANIFEST_FEATURES)
            message(FATAL_ERROR "Missing Jolt manifest feature for ${level}")
        endif()
        set(features "${feature}")
    elseif(VCPKG_MANIFEST_FEATURES MATCHES "jolt-avx")
        message(FATAL_ERROR "Stale Jolt SIMD feature for ${level}")
    endif()
    divide_jolt_simd_options("${features}" x64 options)
    foreach(option IN ITEMS SSE4_1 SSE4_2 AVX AVX2 AVX512 LZCNT TZCNT F16C FMADD)
        set(expected OFF)
        if(option MATCHES "^SSE4")
            set(expected ON)
        elseif(option STREQUAL "AVX" AND level MATCHES "^AVX")
            set(expected ON)
        elseif(option STREQUAL "AVX512" AND level STREQUAL "AVX512")
            set(expected ON)
        elseif(NOT option STREQUAL "AVX512" AND level MATCHES "^AVX(2|512)$")
            set(expected ON)
        endif()
        if(NOT "-DUSE_${option}=${expected}" IN_LIST options)
            message(FATAL_ERROR "${level}: incorrect ${option}: ${options}")
        endif()
    endforeach()
    divide_jolt_simd_options("${features}" arm64 options)
    if(options MATCHES "=ON")
        message(FATAL_ERROR "ARM targets must not enable x86 SIMD: ${options}")
    endif()
endforeach()

set(MAC_OS_BUILD ON)
set(CMAKE_OSX_ARCHITECTURES x86_64)
set(DIVIDE_VECTOR_EXTENSION_SET AVX2)
include("${CMAKE_CURRENT_LIST_DIR}/../ConfigureDependencies.cmake")
if(VCPKG_MANIFEST_FEATURES MATCHES "jolt-avx")
    message(FATAL_ERROR "macOS x86_64 dependencies must remain Rosetta-compatible")
endif()
message(STATUS "Jolt SIMD configuration tests passed")
