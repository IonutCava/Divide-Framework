set(AVX512F_OPT OFF)
set(AVX512VL_OPT OFF)
set(AVX512DQ_OPT OFF)
set(AVX2_OPT OFF)
set(AVX_OPT OFF)
set(SSE41_OPT OFF)
set(SSE42_OPT OFF)
set(SSE4A_OPT OFF)
set(FMA_OPT OFF)
set(FMA4_OPT OFF)
set(BMI1_OPT OFF)
set(BMI2_OPT OFF)
set(POPCNT_OPT OFF)
set(LZCNT_OPT OFF)
set(F16C_OPT OFF)
set(NEON_OPT OFF)
set(ROSETTA2_TARGET OFF)
set(EXTENSIONS "")

# Function to detect if we're targeting Rosetta 2 (x86_64 on Apple Silicon)
function(detect_rosetta2_target)
    if(MAC_OS_BUILD AND CMAKE_OSX_ARCHITECTURES STREQUAL "x86_64")
        # Check if we're running on Apple Silicon
        execute_process(
            COMMAND sysctl -n machdep.cpu.brand_string
            OUTPUT_VARIABLE CPU_BRAND
            OUTPUT_STRIP_TRAILING_WHITESPACE
            ERROR_QUIET
        )
        
        if(CPU_BRAND MATCHES "Apple")
            set(ROSETTA2_TARGET ON PARENT_SCOPE)
            message(STATUS "Detected Rosetta 2 target: x86_64 build on Apple Silicon")
        else()
            set(ROSETTA2_TARGET OFF PARENT_SCOPE)
        endif()
    else()
        set(ROSETTA2_TARGET OFF PARENT_SCOPE)
    endif()
endfunction()

function (Toggle_Available_Vector_Extensions)
    # First detect if we're targeting Rosetta 2
    detect_rosetta2_target()

    # If targeting Rosetta 2, override with safe extensions
    if(ROSETTA2_TARGET)
        message(STATUS "Rosetta 2 target detected - using SSE4.2/POPCNT/LZCNT, disabling AVX/NEON")
        set(SSE41_OPT ON)
        set(SSE42_OPT ON)
        set(POPCNT_OPT ON)
        set(LZCNT_OPT ON)
        set(NEON_OPT OFF)
        set(TARGET_ARCHITECTURE "Rosetta2")
    else()
        OptimizeForArchitecture()
    endif()

    # Only process detected extensions if not overridden by Rosetta 2
    if(NOT ROSETTA2_TARGET)
        foreach(flag ${_enable_vector_unit_list})
            string(TOUPPER "${flag}" flag)

            if ( "${flag}" STREQUAL "NEON")
                set(NEON_OPT ON)
            elseif( "${flag}" STREQUAL "AVX512F")
                set(AVX512F_OPT ON)
            elseif( "${flag}" STREQUAL "AVX512VL")
                set(AVX512VL_OPT ON)
            elseif( "${flag}" STREQUAL "AVX512DQ")
                set(AVX512DQ_OPT ON)
            elseif("${flag}" STREQUAL "AVX2")
                set(AVX2_OPT ON)
            elseif("${flag}" STREQUAL "AVX")
                set(AVX_OPT ON)
            elseif("${flag}" STREQUAL "SSE4.2")
                set(SSE42_OPT ON)
            elseif("${flag}" STREQUAL "SSE4.1")
                set(SSE41_OPT ON)
            elseif("${flag}" STREQUAL "SSE4A")
                set(SSE4A_OPT ON)
            elseif("${flag}" STREQUAL "FMA")
                set(FMA_OPT ON)
            elseif("${flag}" STREQUAL "FMA4")
                set(FMA4_OPT ON)
            elseif("${flag}" STREQUAL "BMI")
                set(BMI1_OPT ON)
            elseif("${flag}" STREQUAL "BMI2")
                set(BMI2_OPT ON)
            elseif("${flag}" STREQUAL "LZCNT")
                set(LZCNT_OPT ON)
            elseif("${flag}" STREQUAL "POPCNT")
                set(POPCNT_OPT ON)
            elseif("${flag}" STREQUAL "F16C")
                set(F16C_OPT ON)
            endif()

        endforeach(flag)
    endif() # End of NOT ROSETTA2_TARGET

    set(AVAILABLE_AVX512F_OPT ${AVX512F_OPT})
    set(AVAILABLE_AVX512VL_OPT ${AVX512VL_OPT})
    set(AVAILABLE_AVX512DQ_OPT ${AVX512DQ_OPT})
    set(AVAILABLE_AVX2_OPT ${AVX2_OPT})
    set(AVAILABLE_AVX_OPT ${AVX_OPT})
    set(AVAILABLE_SSE42_OPT ${SSE42_OPT})
    set(AVAILABLE_SSE41_OPT ${SSE41_OPT})
    set(AVAILABLE_SSE4A_OPT ${SSE4A_OPT})
    set(AVAILABLE_FMA_OPT ${FMA_OPT})
    set(AVAILABLE_FMA4_OPT ${FMA4_OPT})
    set(AVAILABLE_BMI1_OPT ${BMI1_OPT})
    set(AVAILABLE_BMI2_OPT ${BMI2_OPT})
    set(AVAILABLE_POPCNT_OPT ${POPCNT_OPT})
    set(AVAILABLE_LZCNT_OPT ${LZCNT_OPT})
    set(AVAILABLE_F16C_OPT ${F16C_OPT})
    set(AVAILABLE_NEON_OPT ${NEON_OPT})

    # Determine available extension set with cascading
    if(NOT ROSETTA2_TARGET)
        if ( AVX512F_OPT OR AVX512VL_OPT OR AVX512DQ_OPT )
            set(AVX2_OPT ON)
            set(BMI2_OPT ON)
        endif()

        if ( AVX2_OPT )
            set(AVX_OPT ON)
            set(F16C_OPT ON)
            set(BMI1_OPT ON)
            set(FMA_OPT ON)
        endif()
        if ( AVX_OPT )
            set(SSE42_OPT ON)
        endif()

        if ( SSE42_OPT)
            set(SSE41_OPT ON)
            set(POPCNT_OPT ON)
        endif()
    endif()

    macro(_enable_requested_extension _opt_var _request_name)
        if(AVAILABLE_${_opt_var})
            set(${_opt_var} ON)
        else()
            message(WARNING "Requested SIMD extension set '${_request_name}' needs ${_opt_var}, but it is not available for target architecture [${TARGET_ARCHITECTURE}].")
        endif()
    endmacro()

    set(AVX512F_OPT OFF)
    set(AVX512VL_OPT OFF)
    set(AVX512DQ_OPT OFF)
    set(AVX2_OPT OFF)
    set(AVX_OPT OFF)
    set(SSE41_OPT OFF)
    set(SSE42_OPT OFF)
    set(SSE4A_OPT OFF)
    set(FMA_OPT OFF)
    set(FMA4_OPT OFF)
    set(BMI1_OPT OFF)
    set(BMI2_OPT OFF)
    set(POPCNT_OPT OFF)
    set(LZCNT_OPT OFF)
    set(F16C_OPT OFF)
    set(NEON_OPT OFF)

    set(_requested_extension_set "${DIVIDE_VECTOR_EXTENSION_SET}")
    string(TOUPPER "${_requested_extension_set}" _requested_extension_set)
    if(_requested_extension_set STREQUAL "")
        set(_requested_extension_set "AVX2")
    endif()

    set(_valid_extension_sets "AUTO;SSE41;SSE42;AVX;AVX2;AVX512;NEON")
    list(FIND _valid_extension_sets "${_requested_extension_set}" _set_index)
    if(_set_index EQUAL -1)
        message(WARNING "Unknown DIVIDE_VECTOR_EXTENSION_SET='${DIVIDE_VECTOR_EXTENSION_SET}'. Falling back to AVX2.")
        set(_requested_extension_set "AVX2")
    endif()

    if(_requested_extension_set STREQUAL "AUTO")
        set(AVX512F_OPT ${AVAILABLE_AVX512F_OPT})
        set(AVX512VL_OPT ${AVAILABLE_AVX512VL_OPT})
        set(AVX512DQ_OPT ${AVAILABLE_AVX512DQ_OPT})
        set(AVX2_OPT ${AVAILABLE_AVX2_OPT})
        set(AVX_OPT ${AVAILABLE_AVX_OPT})
        set(SSE41_OPT ${AVAILABLE_SSE41_OPT})
        set(SSE42_OPT ${AVAILABLE_SSE42_OPT})
        set(SSE4A_OPT ${AVAILABLE_SSE4A_OPT})
        set(FMA_OPT ${AVAILABLE_FMA_OPT})
        set(FMA4_OPT ${AVAILABLE_FMA4_OPT})
        set(BMI1_OPT ${AVAILABLE_BMI1_OPT})
        set(BMI2_OPT ${AVAILABLE_BMI2_OPT})
        set(POPCNT_OPT ${AVAILABLE_POPCNT_OPT})
        set(LZCNT_OPT ${AVAILABLE_LZCNT_OPT})
        set(F16C_OPT ${AVAILABLE_F16C_OPT})
        set(NEON_OPT ${AVAILABLE_NEON_OPT})
    elseif(AVAILABLE_NEON_OPT AND NOT AVAILABLE_SSE41_OPT)
        if(NOT _requested_extension_set STREQUAL "NEON")
            message(WARNING "Requested SIMD extension set '${_requested_extension_set}' is not applicable to this ARM target. Falling back to NEON.")
        endif()
        _enable_requested_extension(NEON_OPT "NEON")
    elseif(_requested_extension_set STREQUAL "NEON")
        _enable_requested_extension(NEON_OPT "NEON")
    elseif(_requested_extension_set STREQUAL "SSE41")
        _enable_requested_extension(SSE41_OPT "SSE41")
    elseif(_requested_extension_set STREQUAL "SSE42")
        _enable_requested_extension(SSE42_OPT "SSE42")
        _enable_requested_extension(SSE41_OPT "SSE42")
        _enable_requested_extension(LZCNT_OPT "SSE42")
        _enable_requested_extension(POPCNT_OPT "SSE42")
    elseif(_requested_extension_set STREQUAL "AVX")
        _enable_requested_extension(AVX_OPT "AVX")
        _enable_requested_extension(SSE42_OPT "AVX")
        _enable_requested_extension(SSE4A_OPT "AVX")
        _enable_requested_extension(SSE41_OPT "AVX")
        _enable_requested_extension(LZCNT_OPT "AVX")
        _enable_requested_extension(POPCNT_OPT "AVX")
    elseif(_requested_extension_set STREQUAL "AVX2")
        _enable_requested_extension(AVX2_OPT "AVX2")
        _enable_requested_extension(AVX_OPT "AVX2")
        _enable_requested_extension(F16C_OPT "AVX2")
        _enable_requested_extension(BMI1_OPT "AVX2")
        _enable_requested_extension(FMA_OPT "AVX2")
        _enable_requested_extension(SSE42_OPT "AVX2")
        _enable_requested_extension(SSE4A_OPT "AVX2")
        _enable_requested_extension(SSE41_OPT "AVX2")
        _enable_requested_extension(LZCNT_OPT "AVX2")
        _enable_requested_extension(POPCNT_OPT "AVX2")
    elseif(_requested_extension_set STREQUAL "AVX512")
        _enable_requested_extension(AVX512F_OPT "AVX512")
        _enable_requested_extension(AVX512VL_OPT "AVX512")
        _enable_requested_extension(AVX512DQ_OPT "AVX512")
        _enable_requested_extension(AVX2_OPT "AVX512")
        _enable_requested_extension(BMI2_OPT "AVX512")
        _enable_requested_extension(AVX_OPT "AVX512")
        _enable_requested_extension(F16C_OPT "AVX512")
        _enable_requested_extension(BMI1_OPT "AVX512")
        _enable_requested_extension(FMA_OPT "AVX512")
        _enable_requested_extension(SSE42_OPT "AVX512")
        _enable_requested_extension(SSE4A_OPT "AVX512")
        _enable_requested_extension(SSE41_OPT "AVX512")
        _enable_requested_extension(LZCNT_OPT "AVX512")
        _enable_requested_extension(POPCNT_OPT "AVX512")
    endif()

    if (NOT SSE41_OPT AND NOT NEON_OPT)
        message(FATAL_ERROR "SSE4.1 or NEON was not enabled. SSE4.1 on x86 or NEON on ARM is a minimum requirement in order for the build to proceed!")
    endif()

    if ( WINDOWS_OS_BUILD )

        if ( AVX512F_OPT AND AVX512VL_OPT AND AVX512DQ_OPT )
            list(APPEND EXTRA_COMPILE_FLAGS "/arch:AVX512")
        elseif(AVX2_OPT)
            list(APPEND EXTRA_COMPILE_FLAGS "/arch:AVX2")
        elseif(AVX_OPT)
            list(APPEND EXTRA_COMPILE_FLAGS "/arch:AVX")
        endif()

    else() #WINDOWS_OS_BUILD

        if ( NEON_OPT )
            list(APPEND EXTRA_COMPILE_FLAGS "-march=armv8-a+fp+simd")
        endif()

        if ( NOT NEON_OPT )
            if ( AVX512F_OPT )
                list(APPEND EXTRA_COMPILE_FLAGS "-mavx512f")
            else()
                list(APPEND EXTRA_COMPILE_FLAGS "-mno-avx512f")
            endif()

            if ( AVX512VL_OPT )
                list(APPEND EXTRA_COMPILE_FLAGS "-mavx512vl")
            else()
                list(APPEND EXTRA_COMPILE_FLAGS "-mno-avx512vl")
            endif()

            if ( AVX512DQ_OPT )
                list(APPEND EXTRA_COMPILE_FLAGS "-mavx512dq")
            else()
                list(APPEND EXTRA_COMPILE_FLAGS "-mno-avx512dq")
            endif()

            if (AVX2_OPT)
                list(APPEND EXTRA_COMPILE_FLAGS "-mavx2")
            elseif (AVX_OPT)
                list(APPEND EXTRA_COMPILE_FLAGS "-mavx")
                list(APPEND EXTRA_COMPILE_FLAGS "-mno-avx2")
            elseif (SSE42_OPT)
                list(APPEND EXTRA_COMPILE_FLAGS "-msse4.2")
                list(APPEND EXTRA_COMPILE_FLAGS "-mno-avx")
                list(APPEND EXTRA_COMPILE_FLAGS "-mno-avx2")
            elseif (SSE41_OPT)
                list(APPEND EXTRA_COMPILE_FLAGS "-msse4.1")
                list(APPEND EXTRA_COMPILE_FLAGS "-mno-sse4.2")
                list(APPEND EXTRA_COMPILE_FLAGS "-mno-avx")
                list(APPEND EXTRA_COMPILE_FLAGS "-mno-avx2")
            endif()

            if (SSE4A_OPT)
                list(APPEND EXTRA_COMPILE_FLAGS "-msse4a")
            else()
                list(APPEND EXTRA_COMPILE_FLAGS "-mno-sse4a")
            endif()
        endif()
    endif () #WINDOWS_OS_BUILD

    if ( NOT MSVC_COMPILER AND NOT NEON_OPT )
        if ( FMA_OPT )
            list(APPEND EXTRA_COMPILE_FLAGS "-mfma")
        else()
            list(APPEND EXTRA_COMPILE_FLAGS "-mno-fma")
        endif()
        
        if ( FMA4_OPT )
            list(APPEND EXTRA_COMPILE_FLAGS "-mfma4")
        else()
            list(APPEND EXTRA_COMPILE_FLAGS "-mno-fma4")
        endif()

        if ( BMI1_OPT )
            list(APPEND EXTRA_COMPILE_FLAGS "-mbmi")
        else()
            list(APPEND EXTRA_COMPILE_FLAGS "-mno-bmi")
        endif()
         
        if ( BMI2_OPT )
            list(APPEND EXTRA_COMPILE_FLAGS "-mbmi2")
        else()
            list(APPEND EXTRA_COMPILE_FLAGS "-mno-bmi2")
        endif()
        
        if ( LZCNT_OPT )
            list(APPEND EXTRA_COMPILE_FLAGS "-mlzcnt")
        else()
            list(APPEND EXTRA_COMPILE_FLAGS "-mno-lzcnt")
        endif()

        if ( POPCNT_OPT )
            list(APPEND EXTRA_COMPILE_FLAGS "-mpopcnt")
        else()
            list(APPEND EXTRA_COMPILE_FLAGS "-mno-popcnt")
        endif()

        if ( F16C_OPT )
            list(APPEND EXTRA_COMPILE_FLAGS "-f16c")
        else()
            list(APPEND EXTRA_COMPILE_FLAGS "-mno-f16c")
        endif()

    endif() #NOT MSVC_COMPILER

    if (AVX512F_OPT)
        add_compile_definitions( HAS_AVX512F )
    endif()

    if (AVX512VL_OPT)
        add_compile_definitions( HAS_AVX512VL )
    endif()

    if (AVX512DQ_OPT)
        add_compile_definitions( AVX512DQ )
    endif()

    if ( FMA_OPT )
        add_compile_definitions( HAS_FMA )
    endif()

    if ( FMA4_OPT )
        add_compile_definitions( HAS_FMA4 )
    endif()

    if ( BMI1_OPT )
        add_compile_definitions( HAS_BMI1 )
    endif()

    if ( BMI2_OPT )
        add_compile_definitions( HAS_BMI2 )
    endif()

    if ( LZCNT_OPT )
        add_compile_definitions( HAS_LZCNT )
    endif()

    if ( POPCNT_OPT )
        add_compile_definitions( HAS_POPCNT )
    endif()

    if ( F16C_OPT )
        add_compile_definitions( HAS_F16C )
    endif()

    set(_feature_labels "NEON;AVX512F;AVX512VL;AVX512DQ;AVX2;AVX;SSE4.2;SSE4A;SSE4.1;FMA;FMA4;BMI;BMI2;LZCNT;POPCNT;F16C")
    set(_feature_available_vars "AVAILABLE_NEON_OPT;AVAILABLE_AVX512F_OPT;AVAILABLE_AVX512VL_OPT;AVAILABLE_AVX512DQ_OPT;AVAILABLE_AVX2_OPT;AVAILABLE_AVX_OPT;AVAILABLE_SSE42_OPT;AVAILABLE_SSE4A_OPT;AVAILABLE_SSE41_OPT;AVAILABLE_FMA_OPT;AVAILABLE_FMA4_OPT;AVAILABLE_BMI1_OPT;AVAILABLE_BMI2_OPT;AVAILABLE_LZCNT_OPT;AVAILABLE_POPCNT_OPT;AVAILABLE_F16C_OPT")
    set(_feature_enabled_vars "NEON_OPT;AVX512F_OPT;AVX512VL_OPT;AVX512DQ_OPT;AVX2_OPT;AVX_OPT;SSE42_OPT;SSE4A_OPT;SSE41_OPT;FMA_OPT;FMA4_OPT;BMI1_OPT;BMI2_OPT;LZCNT_OPT;POPCNT_OPT;F16C_OPT")

    math(EXPR _feature_last_idx "16 - 1")
    foreach(_i RANGE 0 ${_feature_last_idx})
        list(GET _feature_labels ${_i} _feature_label)
        list(GET _feature_enabled_vars ${_i} _feature_enabled_var)

        if(NOT ${_feature_enabled_var})
            string(TOUPPER "${_feature_label}" _feature_define)
            string(REPLACE "." "_" _feature_define "${_feature_define}")
            remove_definitions("-D__${_feature_define}__")
        endif()
    endforeach()

    set(_available_extensions "")
    set(_enabled_extensions "")
    set(_supported_but_disabled_extensions "")

    foreach(_i RANGE 0 ${_feature_last_idx})
        list(GET _feature_labels ${_i} _feature_label)
        list(GET _feature_available_vars ${_i} _feature_available_var)
        list(GET _feature_enabled_vars ${_i} _feature_enabled_var)

        if(${_feature_available_var})
            list(APPEND _available_extensions ${_feature_label})
            if(${_feature_enabled_var})
                list(APPEND _enabled_extensions ${_feature_label})
            else()
                list(APPEND _supported_but_disabled_extensions ${_feature_label})
            endif()
        endif()
    endforeach()

    if(_enabled_extensions)
        string(REPLACE ";" ", " EXTENSIONS "${_enabled_extensions}")
    else()
        set(EXTENSIONS "none")
    endif()

    if(_available_extensions)
        string(REPLACE ";" ", " _available_extensions_str "${_available_extensions}")
    else()
        set(_available_extensions_str "none")
    endif()

    if(_supported_but_disabled_extensions)
        string(REPLACE ";" ", " _supported_but_disabled_extensions_str "${_supported_but_disabled_extensions}")
    else()
        set(_supported_but_disabled_extensions_str "none")
    endif()

    set(AVX512F_OPT         ${AVX512F_OPT}        PARENT_SCOPE)
    set(AVX512VL_OPT        ${AVX512VL_OPT}       PARENT_SCOPE)
    set(AVX512DQ_OPT        ${AVX512DQ_OPT}       PARENT_SCOPE)
    set(AVX2_OPT            ${AVX2_OPT}           PARENT_SCOPE)
    set(AVX_OPT             ${AVX_OPT}            PARENT_SCOPE)
    set(SSE42_OPT           ${SSE42_OPT}          PARENT_SCOPE)
    set(SSE41_OPT           ${SSE41_OPT}          PARENT_SCOPE)
    set(SSE4A_OPT           ${SSE4A_OPT}          PARENT_SCOPE)
    set(FMA_OPT             ${FMA_OPT}            PARENT_SCOPE)
    set(FMA4_OPT            ${FMA4_OPT}           PARENT_SCOPE)
    set(BMI1_OPT            ${BMI1_OPT}           PARENT_SCOPE)
    set(BMI2_OPT            ${BMI2_OPT}           PARENT_SCOPE)
    set(LZCNT_OPT           ${LZCNT_OPT}          PARENT_SCOPE)
    set(POPCNT_OPT          ${POPCNT_OPT}         PARENT_SCOPE)
    set(F16C_OPT            ${F16C_OPT}           PARENT_SCOPE)
    set(ROSETTA2_TARGET     ${ROSETTA2_TARGET}    PARENT_SCOPE)
    set(EXTENSIONS          ${EXTENSIONS}         PARENT_SCOPE)
    set(EXTRA_COMPILE_FLAGS ${EXTRA_COMPILE_FLAGS} PARENT_SCOPE)

    message(STATUS "Target architecture: ${TARGET_ARCHITECTURE}")
    message(STATUS "Requested SIMD extension set: ${_requested_extension_set}")
    message(STATUS "Detected supported SIMD extensions: ${_available_extensions_str}")
    message(STATUS "Enabled SIMD extensions: ${EXTENSIONS}")
    message(STATUS "Supported but not enabled SIMD extensions: ${_supported_but_disabled_extensions_str}")
    message(STATUS "Extension specific compiler options: ${EXTRA_COMPILE_FLAGS}")

endfunction()
