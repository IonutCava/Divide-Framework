{
  "name": "assimp",
  "version": "6.0.5",
  "port-version": 1,
  "description": "Divide's import-only Assimp build",
  "homepage": "https://github.com/assimp/assimp",
  "license": "BSD-2-Clause AND BSD-3-Clause AND ISC AND MIT",
  "dependencies": [
    "minizip",
    "pugixml",
    "rapidjson",
    "stb",
    "utfcpp",
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    },
    "zlib"
  ],
  "features": {
    "draco": {
      "description": "Enable Draco compressed mesh support",
      "dependencies": [
        "draco"
      ]
    }
  }
}
