{
    "name": "divide-framework",
    "version-string": "latest",
    "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "dependencies": [
    "pkgconf",
    "boost-property-tree",
    {
      "name": "boost-asio",
      "default-features": false
    },
    "stb",
    "freetype",
    "fmt",
    "concurrentqueue",
    {
      "name": "devil",
      "default-features": false
    },
    "eastl",
    "simpleini",
    "glbinding",
    "glm",
    "openal-soft",
    "expat",
    "recastnavigation",
    "imgui-node-editor",
    "vulkan",
    "vulkan-memory-allocator",
    "vk-bootstrap",
    "ctre",
    "assimp",
    "mimalloc",
    "imguizmo",
    "meshoptimizer",
    "spirv-reflect",
    "chaiscript",
    {
      "name": "sdl3-mixer",
      "default-features": false,
      "features": [
        "fluidsynth",
        "libflac",
        "libvorbis"
      ]
    },
    {
      "name": "joltphysics",
      "features": [
        "debugrenderer",
        "profiler",
        "rtti"
      ]
    },
    {
      "name": "sdl3",
      "features": [
        "vulkan"
      ]
    },
    {
      "name": "sdl3-image",
      "features": [
        "jpeg",
        "png"
      ]
    },
    {
      "name": "imgui",
      "features": [
        "docking-experimental",
        "no-obsolete-keyio",
        "no-obsolete-functions",
        "sdl3-binding",
        "sdl3-renderer-binding"
      ]
    },
    {
      "name": "glslang",
      "features": [
        "rtti"
      ]
    },
    {
      "name": "nvtt",
      "platform": "!osx"
    },
    {
      "name": "date",
      "platform": "osx"
    },
    {
      "name": "sse2neon",
      "platform": "osx"
    },
    {
      "name": "wayland",
      "platform": "linux"
    }
  ],
  "features": {
    "jolt-avx": {
      "description": "Use AVX, without AVX2 or additional AVX2-era instructions, in Jolt",
      "dependencies": [{ "name": "joltphysics", "features": ["avx"] }]
    },
    "jolt-avx2": {
      "description": "Use the AVX2 SIMD level in Jolt",
      "dependencies": [{ "name": "joltphysics", "features": ["avx2"] }]
    },
    "jolt-avx512": {
      "description": "Use the AVX512 SIMD level in Jolt",
      "dependencies": [{ "name": "joltphysics", "features": ["avx512"] }]
    },
    "tests": {
      "description": "Build the internal Catch2 test executables",
      "dependencies": [
        "catch2"
      ]
    }
  }
}